  "required": [
    "archetype",
    "mechanics",
    "theme"
  ],
  "additionalProperties": false,
  "$defs": {
    "visual": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "visualPrompt": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "primaryColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accentColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "sprite": {
              "type": "string",
              "pattern": "^assets/[a-zA-Z0-9_-]+[.]png$"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
