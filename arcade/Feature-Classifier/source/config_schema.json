              "type": "string",
              "minLength": 1
            },
            "primaryColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accentColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "type",
            "intensity",
            "angle",
            "tint"
          ],
          "additionalProperties": false
