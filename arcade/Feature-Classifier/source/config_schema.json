{
  "type": "object",
  "properties": {
    "archetype": {
      "const": "classifier"
    },
    "mechanics": {
      "type": "object",
      "properties": {
        "features": {
          "description": "Properties each item has. Exactly one is the spurious feature (easy to latch onto, not causal); exactly one is the true feature (what actually defines the class).",
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "values",
              "role"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "role": {
                "enum": [
                  "true",
                  "spurious",
                  "noise"
                ]
              }
            }
          }
        },
        "training_pool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "bias_strength"
          ],
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 4,
              "maximum": 12
            },
            "bias_strength": {
              "description": "Requested initial fraction aligned with the misleading feature, rounded to a whole number of items. Extra counterexamples are always available for repair.",
              "type": "number",
              "minimum": 0.5,
              "maximum": 1.0
            }
          }
        },
        "class_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "feature",
            "class_a_value",
            "class_b_value"
          ],
          "properties": {
            "feature": {
              "type": "string",
              "minLength": 1
            },
            "class_a_value": {
              "type": "string"
            },
            "class_b_value": {
              "type": "string"
            }
          }
        },
        "curveballs": {
          "description": "Fixed test suite; expected_model_failure describes the baseline misleading-feature rule, not the result after every training choice.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "item",
              "expected_model_failure"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "item": {
                "description": "feature name -> value, e.g. {\"color\": \"green\", \"shape\": \"bug\"}",
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "expected_model_failure": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "required": [
        "features",
        "training_pool",
        "class_rule",
        "curveballs"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "subtitle": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "setting": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "minLength": 1
        },
        "tutorial": {
          "type": "string",
          "minLength": 1
        },
        "practice": {
          "type": "string",
          "minLength": 1
        },
        "begin": {
          "type": "string",
          "minLength": 1
        },
        "skip": {
          "type": "string",
          "minLength": 1
        },
        "guide": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "again": {
          "type": "string",
          "minLength": 1
        },
        "success": {
          "type": "string",
          "minLength": 1
        },
        "failure": {
          "type": "string",
          "minLength": 1
        },
        "hintLabel": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "featureLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "sprites": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "class0_prompt": {
              "type": "string"
            },
            "class0_asset": {
              "type": "string"
            },
            "class1_prompt": {
              "type": "string"
            },
            "class1_asset": {
              "type": "string"
            }
          }
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "floor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "stripe": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "team0": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "team1": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "setting_name",
            "floor_style",
            "primary_color",
            "secondary_color",
            "accent_color",
            "props"
          ],
          "properties": {
            "preset": {
              "const": "space-station"
            },
            "setting_name": {
              "type": "string",
              "minLength": 1
            },
            "floor_style": {
              "$ref": "#/$defs/visual"
            },
            "primary_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "secondary_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "accent_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "props": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/visual"
              },
              "minItems": 2,
              "maxItems": 8,
              "uniqueItems": true
            },
            "layout": {
              "enum": [
                "space-station",
                "speakeasy",
                "party",
                "wasteland",
                "laboratory",
                "clinical",
                "newsroom",
                "archive",
                "reactor-core",
                "observation-deck",
                "forest-edge",
                "misty-hollow",
                "ancient-ruins"
              ]
            }
          }
        },
        "backgroundSprite": {
          "type": "string",
          "minLength": 1
        },
        "class0Sprite": {
          "type": "string",
          "minLength": 1
        },
        "class1Sprite": {
          "type": "string",
          "minLength": 1
        },
        "backgroundImage": {
          "type": "string",
          "minLength": 1
        },
        "class0": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "class1": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "trueFeature": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          ]
        },
        "spuriousFeatures": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "title",
        "setting",
        "accent",
        "tutorial",
        "practice",
        "begin",
        "skip",
        "guide",
        "check",
        "again",
        "success",
        "failure",
        "hintLabel",
        "hint",
        "options",
        "featureLabels"
      ],
      "additionalProperties": false
    },
    "world_physics": {
      "$ref": "../../world_physics.schema.json"
    },
    "tilemap": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^[.#?~LRS]{20}$"
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "weather": {
          "type": "object",
          "properties": {
            "type": {
              "$ref": "#/$defs/visual"
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "angle": {
              "type": "number"
            },
            "tint": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "shape": {
              "type": "string",
              "minLength": 1
            },
            "vx": {
              "type": "number",
              "minimum": -500,
              "maximum": 500
            },
            "vy": {
              "type": "number",
              "minimum": -500,
              "maximum": 500
            },
            "size": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 64
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 150
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "glow": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "pulseHz": {
              "type": "number",
