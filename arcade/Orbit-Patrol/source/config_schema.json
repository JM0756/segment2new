{
  "type": "object",
  "properties": {
    "archetype": {
      "const": "orbit"
    },
    "mechanics": {
      "type": "object",
      "properties": {
        "features": {
          "description": "Properties each item has. Exactly one is the spurious feature (easy to latch onto, not causal); exactly one is the true feature (what actually defines the class).",
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "values",
              "role"
            ],
            "properties": {
              "name": {
                "enum": [
                  "color",
                  "shape",
                  "size"
                ]
              },
              "values": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "role": {
                "enum": [
                  "true",
                  "spurious",
                  "noise"
                ]
              }
            }
          }
        },
        "training_pool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "bias_strength"
          ],
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 4,
              "maximum": 12
            },
            "bias_strength": {
              "description": "Requested initial fraction aligned with the misleading feature, rounded to a whole number of items. Extra counterexamples are always available for repair.",
              "type": "number",
              "minimum": 0.5,
              "maximum": 1.0
            }
          }
        },
        "class_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "feature",
            "class_a_value",
            "class_b_value"
          ],
          "properties": {
            "feature": {
              "enum": [
                "color",
                "shape",
                "size"
              ]
            },
            "class_a_value": {
              "type": "string"
            },
            "class_b_value": {
              "type": "string"
            }
          }
        },
        "curveballs": {
          "description": "Fixed test suite; expected_model_failure describes the baseline misleading-feature rule, not the result after every training choice.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "item",
              "expected_model_failure"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "item": {
                "description": "feature name -> value, e.g. {\"color\": \"green\", \"shape\": \"bug\"}",
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "expected_model_failure": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "required": [
        "features",
        "training_pool",
        "class_rule",
        "curveballs"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "setting": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "minLength": 1
        },
        "tutorial": {
          "type": "string",
          "minLength": 1
        },
        "practice": {
          "type": "string",
          "minLength": 1
        },
        "begin": {
          "type": "string",
          "minLength": 1
        },
        "skip": {
          "type": "string",
          "minLength": 1
        },
        "guide": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "again": {
          "type": "string",
          "minLength": 1
        },
        "success": {
          "type": "string",
          "minLength": 1
        },
        "failure": {
          "type": "string",
          "minLength": 1
        },
        "hintLabel": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "featureLabels": {
          "type": "object",
          "properties": {
            "green": {
              "type": "string",
              "minLength": 1
            },
            "red": {
              "type": "string",
              "minLength": 1
            },
            "round": {
              "type": "string",
              "minLength": 1
            },
            "spiky": {
              "type": "string",
              "minLength": 1
            },
            "color": {
              "type": "string",
              "minLength": 1
            },
            "shape": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "green",
            "red",
            "round",
            "spiky",
            "color",
            "shape"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "sprites": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "class0_prompt": {
              "type": "string"
            },
            "class0_asset": {
              "type": "string"
            },
            "class1_prompt": {
              "type": "string"
            },
            "class1_asset": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "title",
        "setting",
        "accent",
        "tutorial",
        "practice",
        "begin",
        "skip",
        "guide",
        "check",
        "again",
        "success",
        "failure",
        "hintLabel",
        "hint",
        "options",
        "featureLabels"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "archetype",
    "mechanics",
    "theme"
  ],
  "additionalProperties": false
}
