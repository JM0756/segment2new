{
  "type": "object",
  "properties": {
    "archetype": {
      "const": "sorter"
    },
    "mechanics": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": [
              0,
              1
            ]
          }
        },
        "pace": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        }
      },
      "required": [
        "samples",
        "pace"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "subtitle": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "setting": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "minLength": 1
        },
        "tutorial": {
          "type": "string",
          "minLength": 1
        },
        "practice": {
          "type": "string",
          "minLength": 1
        },
        "begin": {
          "type": "string",
          "minLength": 1
        },
        "skip": {
          "type": "string",
          "minLength": 1
        },
        "guide": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "again": {
          "type": "string",
          "minLength": 1
        },
        "success": {
          "type": "string",
          "minLength": 1
        },
        "failure": {
          "type": "string",
          "minLength": 1
        },
        "hintLabel": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "sprites": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "class0_prompt": {
              "type": "string"
            },
            "class0_asset": {
              "type": "string"
            },
            "class1_prompt": {
              "type": "string"
            },
            "class1_asset": {
              "type": "string"
            }
          }
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "floor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "stripe": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "team0": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "team1": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "setting_name",
            "floor_style",
            "primary_color",
            "secondary_color",
            "accent_color",
            "props"
          ],
          "properties": {
            "preset": {
              "const": "space-station"
            },
            "setting_name": {
              "type": "string",
              "minLength": 1
            },
            "floor_style": {
              "$ref": "#/$defs/visual"
            },
            "primary_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "secondary_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "accent_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "props": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/visual"
              },
              "minItems": 2,
              "maxItems": 8,
              "uniqueItems": true
            },
            "layout": {
              "enum": [
                "space-station",
                "speakeasy",
                "party",
                "wasteland",
                "laboratory",
                "clinical",
                "newsroom",
                "archive",
                "reactor-core",
                "observation-deck",
                "forest-edge",
                "misty-hollow",
                "ancient-ruins"
              ]
            }
          }
        },
        "backgroundSprite": {
          "type": "string",
          "minLength": 1
        },
        "class0Sprite": {
          "type": "string",
          "minLength": 1
        },
        "class1Sprite": {
          "type": "string",
          "minLength": 1
        },
        "backgroundImage": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "setting",
        "accent",
        "tutorial",
        "practice",
        "begin",
        "skip",
        "guide",
        "check",
        "again",
        "success",
        "failure",
        "hintLabel",
        "hint",
        "options"
      ],
      "additionalProperties": false
    },
    "world_physics": {
      "$ref": "../../world_physics.schema.json"
    },
    "tilemap": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^[.#?~LRS]{20}$"
      }
    }
  },
  "required": [
    "archetype",
    "mechanics",
    "theme"
  ],
  "additionalProperties": false,
  "$defs": {
    "visual": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "visualPrompt": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "primaryColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accentColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "sprite": {
              "type": "string",
              "pattern": "^assets/[a-zA-Z0-9_-]+[.]png$"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
