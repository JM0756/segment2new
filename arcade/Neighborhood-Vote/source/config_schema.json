{
  "type": "object",
  "properties": {
    "archetype": {
      "const": "neighbors"
    },
    "mechanics": {
      "type": "object",
      "properties": {
        "target": {
          "type": "integer"
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "k": {
          "type": "integer"
        }
      },
      "required": [
        "target",
        "positions",
        "classes",
        "k"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "subtitle": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "setting": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "minLength": 1
        },
        "tutorial": {
          "type": "string",
          "minLength": 1
        },
        "practice": {
          "type": "string",
          "minLength": 1
        },
        "begin": {
          "type": "string",
          "minLength": 1
        },
        "skip": {
          "type": "string",
          "minLength": 1
        },
        "guide": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "again": {
          "type": "string",
          "minLength": 1
        },
        "success": {
          "type": "string",
          "minLength": 1
        },
        "failure": {
          "type": "string",
          "minLength": 1
        },
        "hintLabel": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "classLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "prediction": {
          "type": "string"
        },
        "sprites": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "class0_prompt": {
              "type": "string"
            },
            "class0_asset": {
              "type": "string"
            },
            "class1_prompt": {
              "type": "string"
            },
            "class1_asset": {
              "type": "string"
            }
          }
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "floor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "stripe": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "team0": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "team1": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "setting_name",
            "floor_style",
            "primary_color",
            "secondary_color",
            "accent_color",
            "props"
          ],
          "properties": {
            "preset": {
              "const": "space-station"
            },
            "setting_name": {
              "type": "string",
              "minLength": 1
            },
            "floor_style": {
              "enum": [
                "deck",
                "dance_tiles",
                "parquet",
                "asphalt",
                "stone",
                "turf"
              ]
            },
            "primary_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "secondary_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "accent_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "props": {
              "type": "array",
              "items": {
                "enum": [
                  "viewport",
                  "airlock",
                  "consoles",
                  "red_cups",
                  "dj_booth",
                  "string_lights",
                  "dance_tiles",
                  "velvet_booths",
                  "brass_rail",
                  "stage_spotlight",
                  "barrels",
                  "rubble",
                  "trees",
                  "crates",
                  "shelves",
                  "desk_lamps",
                  "barriers"
                ]
              },
              "minItems": 2,
              "maxItems": 8,
              "uniqueItems": true
            },
            "layout": {
              "enum": [
                "space-station",
                "speakeasy",
                "party",
                "wasteland",
                "laboratory",
                "clinical",
                "newsroom",
                "archive",
                "reactor-core",
                "observation-deck",
                "forest-edge",
                "misty-hollow",
                "ancient-ruins"
              ]
            }
          }
        },
        "backgroundSprite": {
          "type": "string",
          "minLength": 1
        },
        "class0Sprite": {
          "type": "string",
          "minLength": 1
        },
        "class1Sprite": {
          "type": "string",
          "minLength": 1
        },
        "backgroundImage": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "setting",
        "accent",
        "tutorial",
        "practice",
        "begin",
        "skip",
        "guide",
        "check",
        "again",
        "success",
        "failure",
        "hintLabel",
        "hint",
        "classLabels",
        "prediction"
      ],
      "additionalProperties": false
    },
    "world_physics": {
      "$ref": "../../world_physics.schema.json"
    },
    "tilemap": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^[.#?~LRS]{20}$"
      }
    }
  },
  "required": [
    "archetype",
    "mechanics",
    "theme"
  ],
  "additionalProperties": false
}
