{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classifier_bias_lab.config.v0",
  "title": "Classifier / Bias Lab activity config",
  "description": "Configuration for a deterministic decision-stump teaching simulation. One class-defining feature, one misleading feature, optional noise. This is a simplified model, not a trained neural network.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "archetype",
    "concept",
    "level",
    "theme",
    "features",
    "training_pool",
    "curveballs",
    "instructions",
    "hints",
    "ui",
    "class_rule"
  ],
  "properties": {
    "archetype": {
      "const": "classifier_bias_lab"
    },
    "concept": {
      "enum": [
        "overfitting",
        "data_bias"
      ]
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "label"
      ],
      "properties": {
        "tier": {
          "enum": [
            1,
            2
          ]
        },
        "label": {
          "enum": [
            "literacy",
            "fluency"
          ]
        }
      }
    },
    "theme": {
      "description": "Cosmetic only. sprite_key must be one of the pre-made sprite sets the template ships with.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setting",
        "class_a",
        "class_b",
        "sprite_set"
      ],
      "properties": {
        "setting": {
          "type": "string",
          "maxLength": 80
        },
        "class_a": {
          "type": "string",
          "maxLength": 30
        },
        "class_b": {
          "type": "string",
          "maxLength": 30
        },
        "sprite_set": {
          "enum": [
            "aliens_bugs",
            "fruit_rocks",
            "cats_dogs"
          ]
        }
      }
    },
    "features": {
      "description": "Properties each item has. Exactly one is the spurious feature (easy to latch onto, not causal); exactly one is the true feature (what actually defines the class).",
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "values",
          "role"
        ],
        "properties": {
          "name": {
            "enum": [
              "color",
              "shape",
              "size"
            ]
          },
          "values": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "role": {
            "enum": [
              "true",
              "spurious",
              "noise"
            ]
          }
        }
      }
    },
    "training_pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "bias_strength"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 4,
          "maximum": 12
        },
        "bias_strength": {
          "description": "Requested initial fraction aligned with the misleading feature, rounded to a whole number of items. Extra counterexamples are always available for repair.",
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.0
        }
      }
    },
    "curveballs": {
      "description": "Fixed test suite; expected_model_failure describes the baseline misleading-feature rule, not the result after every training choice.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "item",
          "expected_model_failure"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "item": {
            "description": "feature name -> value, e.g. {\"color\": \"green\", \"shape\": \"bug\"}",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "expected_model_failure": {
            "type": "boolean"
          }
        }
      }
    },
    "instructions": {
      "type": "string",
      "maxLength": 400
    },
    "hints": {
      "description": "Templates only. The template fills {spurious_feature} and {true_feature} from the learner's actual training choices, so the hint references what they did.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_failure",
        "on_success"
      ],
      "properties": {
        "on_failure": {
          "type": "string",
          "maxLength": 300
        },
        "on_success": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "show_confidence_meter",
        "show_vocab_terms"
      ],
      "properties": {
        "show_confidence_meter": {
          "type": "boolean"
        },
        "show_vocab_terms": {
          "type": "boolean"
        }
      }
    },
    "meta": {
      "description": "Filled in by generator code, NOT by the LLM: model, prompt_version, generated_at, attempt, schema tags (level/audience/time).",
      "type": "object"
    },
    "class_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature",
        "class_a_value",
        "class_b_value"
      ],
      "properties": {
        "feature": {
          "enum": [
            "color",
            "shape",
            "size"
          ]
        },
        "class_a_value": {
          "type": "string"
        },
        "class_b_value": {
          "type": "string"
        }
      }
    }
  }
}
